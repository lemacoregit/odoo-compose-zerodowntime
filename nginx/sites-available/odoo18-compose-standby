upstream odoo_standby {
    server 127.0.0.1:8118;
}

upstream odoo_standby_longpolling {
    server 127.0.0.1:8127;
}

server {
    listen 80;
    server_name erp.zerodowntime.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name erp.zerodowntime.com;

    ssl_certificate     /etc/letsencrypt/live/erp.zerodowntime.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.zerodowntime.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/odoo18-compose-standby.access.log;
    error_log  /var/log/nginx/odoo18-compose-standby.error.log;

    # Longpolling
    location /longpolling {
        proxy_pass http://odoo_standby_longpolling;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 720s;
        proxy_connect_timeout 720s;
        proxy_send_timeout 720s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    location /websocket {
        proxy_pass http://odoo_standby_longpolling;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass          http://odoo_standby;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_read_timeout    720s;
        proxy_connect_timeout 720s;
        proxy_send_timeout    720s;
        proxy_buffering       on;
        proxy_buffer_size     128k;
        proxy_buffers         4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Static files cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|woff|woff2|ttf|svg)$ {
        proxy_pass       http://odoo_standby;
        proxy_cache_valid 200 60m;
        expires 864000;
        add_header Cache-Control "public, immutable";
    }

    client_max_body_size 100m;
    keepalive_timeout    65;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript;
}
